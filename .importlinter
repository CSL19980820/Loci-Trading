[importlinter]
root_package = src
include_external_packages = True

# Block direct imports of sibling infrastructure modules; package-root re-exports are allowed.
# Keep same-context api/application/domain/infrastructure imports in allowed_importers.

[importlinter:contract:protect-market-infra]
name = Protect market.infrastructure
type = protected
protected_modules =
    src.market.infrastructure
allowed_importers =
    src.market
    src.market.api
    src.market.application
    src.market.domain
    src.market.infrastructure

[importlinter:contract:protect-ledger-infra]
name = Protect ledger.infrastructure
type = protected
protected_modules =
    src.ledger.infrastructure
allowed_importers =
    src.ledger
    src.ledger.api
    src.ledger.application
    src.ledger.domain
    src.ledger.infrastructure

[importlinter:contract:protect-ops-infra]
name = Protect ops.infrastructure
type = protected
protected_modules =
    src.ops.infrastructure
allowed_importers =
    src.ops
    src.ops.api
    src.ops.application
    src.ops.domain
    src.ops.infrastructure

