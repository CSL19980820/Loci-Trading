    src.backtest.api
    src.backtest.application
    src.backtest.domain
    src.backtest.infrastructure

[importlinter:contract:domain-no-web-framework]
name = Domain must not import FastAPI
type = forbidden
source_modules =
    src.ledger.domain
    src.market.domain
    src.review.domain
    src.strategy.domain
    src.ops.domain
    src.ai.domain
    src.intel.domain
    src.backtest.domain
    src.formula.domain
forbidden_modules =
    fastapi
    starlette
    httpx
    httpx2
allow_indirect_imports = false
