dist/Loci.exe

# 数据库与运行时数据：账本/行情/运维状态都不进仓库
data/
*.db
*.db-wal
*.db-shm

# 密钥
.env
.env.*
!.env.example
.palace_ai_master_key

# 本机私密记忆 / 主机备注（禁止进仓、禁止上传）
.local/

# 本机 Windows 注册表备份（排障时生成，与本仓无关）
_regbackup_*/

