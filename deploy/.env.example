# 仅放在服务器 /srv/qianlong-palace/.env；不要提交、上传或放进发布目录。
# 逗号分隔的 Host 白名单。首次使用时将域名替换为真实值。
PALACE_ALLOWED_HOSTS=__PALACE_DOMAIN__

# 使用高熵随机值，例如：openssl rand -hex 32
# Web 工作台将把它作为 Bearer Token 发送；令牌只留在浏览器页面内存。
PALACE_WRITE_TOKEN=REPLACE_WITH_A_RANDOM_SECRET

# 单账号登录。仅放在服务器 /srv/qianlong-palace/.env；请勿提交。
PALACE_AUTH_USERNAME=admin
PALACE_AUTH_PASSWORD=REPLACE_WITH_YOUR_PASSWORD
# 使用高熵随机值，例如：openssl rand -hex 32；修改会让现有登录会话失效。
PALACE_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET

# 仅用于 HTTP 临时排障模式（配合 sync-to-server.ps1 的 -AllowInsecureHttp）。
# 留空或不设 = 会话 Cookie 带 Secure 标记，只经 HTTPS 回传，这是默认与推荐值。
# 置为 1 会去掉 Secure：登录凭证将明文经网络传输，仅限你可控的短期排障。
# PALACE_INSECURE_HTTP=1
